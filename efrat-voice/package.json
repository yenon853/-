{
  "name": "efrat-voice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "תשאלו את אפרת – תרגול מודל אפר\"ת עם שיחה קולית בעברית",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "check": "node --check server/index.js && vite build",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
