# ===== מוח השיחה (Gemini) =====
# מפתח מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ===== קול בעברית (Azure AI Speech) =====
# משאב "Speech" בפורטל Azure → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# קולות עבריים (ברירת מחדל: הילה לאפרת, אברי לסבא חכם)
AZURE_VOICE_EFRAT=he-IL-HilaNeural
AZURE_VOICE_GRANDPA=he-IL-AvriNeural

# ===== שרת =====
PORT=8787
